# Ollama server and models (run `ollama pull <model>` for each)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=120

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Document ingestion CLI (existing database/compose.yaml defaults)
DATABASE_URL=postgresql://langan:langan_local_only@localhost:5432/langan_test
STORAGE_ROOT=data
